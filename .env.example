NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role do Supabase (Settings > API) — SÓ usada no servidor (webhook do Mercado Pago
# e consulta de status de pedido de convidado). Nunca prefixar com NEXT_PUBLIC_, nunca usar
# em client component: essa chave ignora todo o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — dashboard > Suas integrações > credenciais (teste primeiro: TEST-..., depois
# produção: APP_USR-...)
MERCADO_PAGO_ACCESS_TOKEN=
# gerado ao configurar o webhook em Suas integrações > Webhooks > Configurar notificação
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública do site (sem barra no final) — usada pra montar os back_urls do Checkout Pro e
# o notification_url. Em dev, aponta pro túnel (ngrok) ou pro preview da Vercel; em produção,
# o domínio real.
NEXT_PUBLIC_APP_URL=
